Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5796875,"digest":"sha256:8338315aec0315a07f0559640cb2edf94640e25c6e63fed50fb23a0d0fec03d1","download_count":10,"created_at":"2026-11-16T19:26:08Z","updated_at":"2026-11-16T19:26:09Z","browser_download_url":"https://github.com/taipei49314/checkwash/releases/download/v0.13.0/checkwash-0.13.0.tar.gz"},{"url":"https://api.github.com/repos/taipei49314/checkwash/releases/assets/756139970","id":756139970,"node_id":"RA_kwDOTq_t9M4tEcfC","name":"checkwash.pyz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1077802,"digest":"sha256:326e2a0c1e5e983869893a4c11c4f0ddba5e75e7c23a8984a3357042a87fbeff","download_count":11,"created_at":"2026-11-16T19:26:11Z","updated_at":"2026-11-16T19:26:12Z","browser_download_url":"https://github.com/taipei49314/checkwash/releases/download/v0.13.0/checkwash.pyz"}],"tarball_url":"https://api.github.com/repos/taipei49314/checkwash/tarball/v0.13.0","zipball_url":"https://api.github.com/repos/taipei49314/checkwash/zipball/v0.13.0","body":"Checkwash v0.13.0 removes four first-week working-tree, helper and virtual-environment rough edges, reports real Python test names on projected findings, keeps strict inert end-of-file appends to repository-root `CLAUDE.md` at `warn`, bounds CPython 3.12+ single-line `tokenize` memory and deep runtime-shadow AST parsing, and adds hosted macOS and Linux release verification. The findings envelope stays at version 2 and the IR at version 3. Details are in the [release guide](https://github.com/taipei49314/checkwash/blob/v0.13.0/docs/releases/v0.13.0-public-launch.md), and the [versioned known issues](https://github.com/taipei49314/checkwash/blob/v0.13.0/docs/KNOWN-ISSUES-v0.13.0.md) disclose the remaining limits. A pass means no known tampering pattern was detected; it is not a correctness guarantee.\n\n**First-week working-tree, helper and virtual-environment fixes (D-205, D-206, D-207, D-208, D-212).** A check without a range and the Stop hook set aside the untracked zipapp checkwash runs from when neither `HEAD` nor the session base holds that path, and `checkwash hook install --agent claude-code` (default `--local`) adds `.claude/settings.local.json` to Git `info/exclude` when Git neither tracks nor ignores it (D-205). Editing a commonly named test helper past the importer search bounds (64 unchanged mentions, 48 unchanged test importers, 192 total importer reads or 16 helper names) no longer stops every check with exit 2 under the default policy unless the diff renames the helper to that name: checkwash sets its unchanged importers aside, checks the helper module's own top-level non-`test*` (and non-`pytest_*` on `conftest`) functions directly across `REPAIR_REFUSED_PYTHON`, and emits an `analysis incomplete` note on stderr, `term`, SARIF `toolExecutionNotifications` and hook `systemMessage` output, while exiting 2 with empty stdout on non-`hook-json` `check` runs when `[gate] on_engine_error = \"block\"` (D-206, D-212). On Windows, Authenticode `# SIG # Begin signature block` trailers at the end of PowerShell scripts are excluded from the test-runner scan so signed `Activate.ps1` files no longer block (D-207). On Linux and macOS, untracked interpreter links under `bin/` or `Scripts/` and `lib64 -> lib` inside a non-root virtual environment with a regular `pyvenv.cfg` (absent from `HEAD` and session base) are set aside in range-less checks and hooks unless a detector must read the path or pytest collection reaches it (D-208).\n\n**Real test names on projected Python findings, test-shaped file notes, and strict inert EOF appends to `CLAUDE.md` (D-210, #610/#616, D-211/D-213).** Findings emitted from projected Python concrete, exception or local-auxiliary units (`test_concrete_*`, `test_exception_*`, `test_local_auxiliary_*`) now report the enclosing Python test's qualified name across `term`, `json`, `sarif` and `hook-json` (`--emit-ir` keeps `qualname` and adds `source_unit` on `Unit`), and non-transitioning edits to single-capture `captured-result` tests skip projection (D-210). Changed Python or JS/TS files that look like test modules but sit outside the zero-configuration parse gates now emit an `analysis incomplete` summary on stderr, `term` and SARIF `toolExecutionNotifications` without changing verdicts or `--format json` stdout (#610, #616). Modifying a tracked repository-root `CLAUDE.md` in place stays at `warn` (`GUARDRAIL_ADDITIVE`, binding `\"additive\": True` into its v2 fingerprint context) only when the edit is a strict inert end-of-file append separated by at least one blank line with clean UTF-8, clean EOF, verbatim frontmatter invariance, zero newly added `Cf`/`Default_Ignorable` code points, and no `---`, `3+` fence characters, `<!--`/`-->` or `[label]:` opener on added lines; prepends, mid-file insertions, adjacent appends, edits, deletions, renames and all other guardrail files escalate to `critical` (D-211, D-213). Exemptions recorded against old synthetic `test_concrete_*` / `test_exception_*` / `test_local_auxiliary_*` keys or old non-additive `CLAUDE.md` keys must be re-recorded ([upgrade notes](https://github.com/taipei49314/checkwash/blob/v0.13.0/docs/embedding.md#v0120-to-v0130)).\n\n**CPython 3.12+ `tokenize` memory bound, fail-closed shadow AST bounds, and shared `GitSnapshot` reads (#607, #609, #613, #617, #618).** `syntax._chains` drops retained `TokenInfo.line` copies and condenses complete non-chain lines past `2,048` characters while preserving multiline PEP 701 `fr\"...\"`/`rf\"...\"` f-strings, avoiding CPython `3.12.3`'s `O(K * L)` `TokenInfo.line` memory blowup; analysed Python parsing suppresses `SyntaxWarning` and `DeprecationWarning`; runtime-shadow helpers convert deep-AST `RecursionError`/`MemoryError` and `parse_ok=False` outcomes into `EngineError`; and CLI range/worktree checks reuse one resolved `GitSnapshot` across base policy, task contract, manifest reads and pytest config pairing.\n\n**The tag at the Action commit (D-200).** As introduced in v0.12.0, annotated tag `v0.13.0` points at the release's Action commit A (`9ada8cfaa618b002b5d0d829c7ddbe1b8e8ae638`) — the commit the GitHub `README.md` recommends as the Action pin once v0.13.0 is publicly verified — and names the release merge M (`7d45814211bbb458d310607b3a241761c7d5f7e3`) on one `Release-Merge:` line. The PyPI distributions and `checkwash.pyz` are built from M, whose `doctor` accepts both v0.12.0's pin and A; install the CLI from PyPI or `checkwash.pyz` rather than through Git from the tag, and upgrade the CLI before advancing the Action pin.\n\n**What was measured.** On LAPTOP-01AGNPJU (`HUMAN_AUTHORIZED_LOCAL_PJU_NOT_EC_POOL`, Windows 11, CPython 3.11.9), the fixed 3,600-commit in-sample comparison (`R29`: 1,800 Python `standard` commits and 1,800 JS/TS commits) compared the published v0.12.0 zipapp (`532f74ab`) against the final 0.13.0 candidate `src/` tree (`cfd205d7`): all 3,600 commits gave identical exit codes and identical `--format json` reports apart from `run` metadata (`1,726` pass and `74` block on Python; `1,748` pass, `50` block and `2` unchanged symlink-refusal errors on JS/TS; `0` movements). The three `uvloop` failure-relay commits that v0.10.0 blocked pass with zero findings on both engines, and the 185-case verdict gate passed with `0` failures and `0` reported movements. An honest unit-less broad `except` in Python beside an opaque production change that D-190 does not prove a relay remains unmeasured in history; Antigravity accepts that risk for 0.13.0 only under delegation ([0.13.0 disposition](https://github.com/taipei49314/checkwash/blob/v0.13.0/docs/d176-cost-disposition-0.13.0.md)). These are in-sample counts, not a false-positive rate.\n\n**How it was released.** Release-stage receipts (`pr`, `main` and `tag` before this Release; `release-event` and `public-visitor` after it) run on LAPTOP-01AGNPJU (Windows 11, CPython 3.11.9, `HUMAN_AUTHORIZED_LOCAL_PJU_NOT_EC_POOL`); native Linux, macOS and other Python versions are `NOT_RUN` in those stage receipts, accepted for 0.13.0 only under the maintainer's pre-1.0 delegation without changing the standing nine-leg contract. Alongside them, the full 23,358-test suite (`23,425` JUnit items) passed on PJU across six isolated Windows 11 + WSL2 Ubuntu 24.04 Python `3.11`/`3.12`/`3.13` legs on `R`, and v0.13.0 runs the GitHub-hosted `macos-latest` (Apple silicon) and `ubuntu-latest` Python `3.11`–`3.13` + Linux composite Action verification (`HUMAN_AUTHORIZED_GITHUB_HOSTED_NOT_PJU_RECEIPT`, D-204) at `M` before the tag and on the published Release files before PyPI deployment review. Antigravity carried out this release on LAPTOP-01AGNPJU under Nelson's one-time 0.13.0 instructions and pre-1.0 delegation; Nelson approved the L1 remediations, the release merge and R29's empty movement list before the tag, and the `pypi` environment deployment waits for Nelson's own approval.\n\nGitHub Release assets, PyPI publication and public-visitor verification follow as separate gated steps. The PyPI package description, built from M, still shows v0.12.0's install commands and Action pin until the public files are verified; the [GitHub README](https://github.com/taipei49314/checkwash#readme) and `release/advertised.toml` advance to v0.13.0 only after public-visitor and hosted-artifact verification succeed ([release procedure](https://github.com/taipei49314/checkwash/blob/v0.13.0/docs/RELEASING.md)). **1.0 readiness remains NOT_MET.**\n"}