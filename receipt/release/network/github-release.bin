ot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5044922,"digest":"sha256:391eb893537f344b05c002358f47f6d89f17c85b9f1f61c1df801fd82360f944","download_count":1,"created_at":"2026-10-27T23:47:38Z","updated_at":"2026-10-27T23:47:38Z","browser_download_url":"https://github.com/taipei49314/checkwash/releases/download/v0.10.0/checkwash-0.10.0.tar.gz"},{"url":"https://api.github.com/repos/taipei49314/checkwash/releases/assets/683236353","id":683236353,"node_id":"RA_kwDOTq_t9M4ouVwB","name":"checkwash.pyz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":952399,"digest":"sha256:9a58d3d48f4f314a46b153bc0b7ad5182829c210a3ce9dae575c46f2f3bc535a","download_count":1,"created_at":"2026-10-27T23:47:39Z","updated_at":"2026-10-27T23:47:40Z","browser_download_url":"https://github.com/taipei49314/checkwash/releases/download/v0.10.0/checkwash.pyz"}],"tarball_url":"https://api.github.com/repos/taipei49314/checkwash/tarball/v0.10.0","zipball_url":"https://api.github.com/repos/taipei49314/checkwash/zipball/v0.10.0","body":"Checkwash v0.10.0 binds policy changes to reviewed BASE and requires source-bound proof before relocated test oracles earn credit. A newly winning `.checkwash` config or allowance is compared with the BASE `.greenwash` predecessor, so HEAD cannot authorize its own relaxation; relative `--task` addresses resolve from `--repo`; and moving assertion text, keeping assertion mass or keeping a test name no longer proves the same oracle. The IR contract advances to version 3 (`policy_shadows`); the findings envelope stays at version 2. Details are in the [release guide](https://github.com/taipei49314/checkwash/blob/v0.10.0/docs/releases/v0.10.0-public-launch.md) and the [repair integration record](https://github.com/taipei49314/checkwash/blob/v0.10.0/docs/repair-integration-0.10.0.md).\n\nBefore the final chain, a review of the candidate fixed three defects, each with regression tests: worktree and Stop checks no longer list the whole working tree on every run, an empty file renamed into priority policy is compared with BASE, and oracle-context line tables count lines the way `ast` does. The [versioned known issues](https://github.com/taipei49314/checkwash/blob/v0.10.0/docs/KNOWN-ISSUES-v0.10.0.md) disclose the remaining limits. D185 records eight golden and four frozen-corpus compatibility movements; CASE_020_windows and CASE_029_flatten remain known legitimate-refactor false blocks. A pass is not a correctness guarantee.\n\nThe fixed-corpus comparison ran on 3,600 in-sample commits (actual v0.9.0 against the candidate engine), and after the review fixes a same-host differential gave results identical to the reviewed candidate on all 3,600; a scan found no member that the last CRLF correction can affect. These are in-sample outcome counts, not a held-out or adjudicated false-positive rate.\n\nRelease evidence for every stage was collected on LAPTOP-01AGNPJU (Windows, Python 3.11.9), recorded as `HUMAN_AUTHORIZED_LOCAL_PJU_NOT_EC_POOL`. Linux, macOS and other Python versions are NOT_RUN for this release; that gap is accepted for v0.10.0 only under the maintainer's pre-1.0 delegation and does not change the standing release contract. This release was carried out by Claude (Claude Code) under that delegation.\n\nGitHub assets, PyPI publication and verification of the actual public bytes are separate steps. The advertised CLI and Action pins advance from v0.9.0 only after public artifact and visitor verification, as the [release procedure](https://github.com/taipei49314/checkwash/blob/v0.10.0/docs/RELEASING.md) requires. The unpublished v0.9.1 tag remains unchanged.\n"}