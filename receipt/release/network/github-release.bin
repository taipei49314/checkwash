bot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":5319763,"digest":"sha256:820164c9331c3662132f8074d7b4c421f1d762fad13d33477f1ab5c2d2aca93e","download_count":1,"created_at":"2026-11-03T22:06:23Z","updated_at":"2026-11-03T22:06:24Z","browser_download_url":"https://github.com/taipei49314/checkwash/releases/download/v0.11.0/checkwash-0.11.0.tar.gz"},{"url":"https://api.github.com/repos/taipei49314/checkwash/releases/assets/707259911","id":707259911,"node_id":"RA_kwDOTq_t9M4qJ-4H","name":"checkwash.pyz","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":996040,"digest":"sha256:3cadde1349fd32ee05e8527601f842c19a16455ec30fae719e33556c60ed7654","download_count":1,"created_at":"2026-11-03T22:06:26Z","updated_at":"2026-11-03T22:06:27Z","browser_download_url":"https://github.com/taipei49314/checkwash/releases/download/v0.11.0/checkwash.pyz"}],"tarball_url":"https://api.github.com/repos/taipei49314/checkwash/tarball/v0.11.0","zipball_url":"https://api.github.com/repos/taipei49314/checkwash/zipball/v0.11.0","body":"Checkwash v0.11.0 adds an edit-time ask for Claude Code, reads failure relays, and lets a release's `doctor` accept its own Action commit. The findings envelope stays at version 2 and the IR at version 3. Details are in the [release guide](https://github.com/taipei49314/checkwash/blob/v0.11.0/docs/releases/v0.11.0-public-launch.md), and the [versioned known issues](https://github.com/taipei49314/checkwash/blob/v0.11.0/docs/KNOWN-ISSUES-v0.11.0.md) disclose the remaining limits. A pass is not a correctness guarantee.\n\n**Claude Code hooks (D-189).** `checkwash hook install --agent claude-code` now adds a PreToolUse handler: when an Edit, Write or MultiEdit of a Python test file would leave a finding of `ASSERT_WEAKENED`, `ASSERT_REMOVED`, `TEST_DISABLED`, `TOLERANCE_LOOSENED` or `BROAD_EXCEPT_ADDED` at high or above, with `oracle_freeze` forced, the hook asks you before the edit is made. It asks on no other rule, so an expected value rewritten to match the current output goes ahead, and an edit made through Bash never reaches it. Under the default `on_engine_error`, an edit it cannot analyse, or cannot analyse within 30 seconds, goes ahead with only a `systemMessage`, and one whose resulting bytes it cannot predict is left to Claude Code's normal permission flow. In a `claude -p` run nobody can answer, so Claude Code denies such an edit; one pre-registered lifecycle run exercised this, for one Edit in `-p` mode only, and the interactive prompt is not verified. The hooks now go to `.claude/settings.local.json` by default; `--shared` writes `.claude/settings.json`, with no PreToolUse handler. With neither flag, a repository whose `.claude/settings.json` already holds checkwash's managed Stop or SessionStart handler, as 0.10.0's default install left it, makes the install exit 2: pass `--shared` to update it there, or `--local` to add machine-local settings beside it. The Stop block no longer offers an exemption command: it tells Claude to fix the production code or to report the finding to you, and a continuation stop on the same blocking set is released with a note instead of being blocked again. Both hooks are author-side checks; the required CI check remains the gate.\n\n**Verdict changes.** A broad `except` in a Python test that hands the failure unchanged to an asyncio future the test awaits, as uvloop's regression tests do, is no longer counted as an added swallow, within the bounded shape SPEC section 4 reads (D-190); honest relays outside that shape still report `BROAD_EXCEPT_ADDED`, for example one on a loop from `asyncio.get_running_loop()` or any relay in a file that uses `mock.patch`. A lone `pytest.raises` carrier folded into a literal `parametrize` table is proved like an assertion, so an honest fold can keep its credit; a test whose parametrize cells never reach it as written gets no assertion keys, so such a fold or move now blocks at high unless the complete unit moved unchanged (D-192). A moved or folded Python test pays for the test it replaces only where the repository's own pytest configuration certainly collects it, and where checkwash cannot read that selection (a `-k` in `addopts`, for example) no Python move or fold earns credit (D-193). #419 closes as a documented residual, not a fix (D-191): a weakened Python or JS/TS test beside an edit that changes nothing can still pass at the default threshold.\n\n**The Action pin (D-194, D-196).** Once this release is publicly verified, the README on `main` recommends the release pull request's content commit, `v0.11.0^2^1` (the tag's second parent's parent, `257150319fca15235185fc629d8b9c21c17166ca`), as the Action pin, not the commit the tag points to (`34555301de3d5ea4b2c8e4470b797a06d0a1e395`). The two differ only in `doctor`'s own pin line, which the pull request's last commit set to the content commit, and the Action runs the same check at either: it runs only `checkwash check`, which never imports `doctor`, though no release stage runs the Action at the content commit itself. `doctor` 0.11.0 accepts v0.10.0's pin and its own; `doctor` 0.10.0 rejects the 0.11.0 pin, so upgrade the CLI and its local hooks before the Action pin. Pin updaters such as Dependabot and Renovate will propose the tag's commit, which `doctor` rejects, and zizmor's `ref-version-mismatch` audit can report the pin's comment (inferred from those tools' documentation, not run). In a clone, `git -C checkwash diff 'v0.11.0^2^1' v0.11.0` shows the one changed line, in `src/checkwash/doctor.py`.\n\n**What was measured.** The fixed-corpus comparison checked 3,600 in-sample commits with actual v0.10.0 and with the candidate engine: every exit code was identical, and no report differed apart from run metadata (the reports were compared during the run but not kept). On these commits the 0.11 changes alter no verdict and no report, so the comparison measures none of their new blocks or new passes; the known issues name them. Separately, in a targeted run on the three uvloop inputs that v0.10.0 blocked, the candidate passes each of them with no finding. These are in-sample outcome counts, not a held-out or adjudicated false-positive rate.\n\n**How it was released.** Release evidence for every stage is collected on LAPTOP-01AGNPJU (Windows, Python 3.11.9) and recorded as `HUMAN_AUTHORIZED_LOCAL_PJU_NOT_EC_POOL`: the pull request, main and tag stages before this Release, and the release-event and public-visitor stages after it. Linux, macOS and other Python versions are NOT_RUN for the release receipts; that gap is accepted for v0.11.0 only under the maintainer's pre-1.0 delegation and does not change the standing release contract. Separately, on the same machine, the full test suite passed on the release's source tree in six local legs (Windows CPython 3.11, 3.12 and 3.13, and Linux CPython 3.11, 3.12 and 3.13 in Docker), and the six corpus outputs were byte-equal; that run is supplementary evidence, not a release receipt, and macOS was not run. Claude (Claude Code) carried out this release under that delegation. The maintainer approved the release merge and reviewed the fixed-corpus comparison's empty list before the tag, and the PyPI deployment waits for the maintainer's own approval.\n\nGitHub assets, PyPI publication and verification of the actual public bytes are separate steps. The advertised CLI and Action pins advance from v0.10.0 only after public artifact and visitor verification, as the [release procedure](https://github.com/taipei49314/checkwash/blob/v0.11.0/docs/RELEASING.md) requires.\n"}