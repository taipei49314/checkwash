# Byte-stability matters to a tool that promises byte-identical verdicts:
# every text file is committed and checked out with LF, on every OS.
* text=auto eol=lf
*.py text eol=lf
*.gwcase text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf

# Fixed already-seen cohort receipts preserve their original CRLF bytes/hash.
tools/r1_seen_cost_data/python-pairs.json -text whitespace=cr-at-eol
tools/r1_seen_cost_data/python-partitions.json -text whitespace=cr-at-eol
