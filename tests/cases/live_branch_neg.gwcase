=== meta ===
rule: ASSERT_REMOVED
title: A genuine runtime condition is not folded away
origin: fable audit — guard against the constant-folder over-reaching
=== before: tests/test_calc.py ===
from app import total


def test_total():
    assert total(3) == 6
=== after: tests/test_calc.py ===
from app import total


def test_total():
    if total(3) > 0:
        assert total(3) == 6
