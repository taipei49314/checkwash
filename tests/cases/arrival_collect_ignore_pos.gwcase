app
=== head: app.py ===
def checked(x):
    if not 0 <= x <= 100:
        raise ValueError(x)
    return x
=== head: conftest.py ===
collect_ignore = ["setup.py"]
collect_ignore.append("test_legacy.py")
=== before: test_app.py ===
import pytest
from app import checked


def test_negative():
    with pytest.raises(ValueError):
        checked(-1)


def test_ok():
    assert checked(50) == 50
