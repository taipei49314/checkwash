=== head: app/billing.py ===
def total():
    return 78.75
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TestTotal(unittest.TestCase):
    def test_total(self):
        self.assertLess(total(), 80)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TestTotal(unittest.TestCase):
    def test_total(self):
        assert total() < 80
