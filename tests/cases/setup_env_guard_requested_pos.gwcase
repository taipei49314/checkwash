=== before: tests/test_quota.py ===
import os

import pytest

from app import remaining


@pytest.fixture
def database():
    if not os.environ.get("DATABASE_URL"):
        pytest.skip("set DATABASE_URL")
    yield


def test_weighted_quota():
    assert remaining(10, [("get", 1), ("bulk", 4)]) == 5
