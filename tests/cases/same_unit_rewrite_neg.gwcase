=== before: tests/test_headers.py ===
from headers import Headers, obfuscate


def test_obfuscate():
    h = Headers({"authorization": "secret"})
    assert obfuscate(h.raw) == [("authorization", "[secure]")]
    assert obfuscate(h.items()) == [("authorization", "[secure]")]
=== after: tests/test_headers.py ===
from headers import Headers, obfuscate


def test_obfuscate():
    h = Headers({"authorization": "secret"})
    assert repr(h) == "Headers({'authorization': '[secure]'})"
