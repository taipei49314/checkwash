=== meta ===
bypass: 104
rule: TEST_DISABLED
title: a subclass that redefines the test runs its own unit, not the base's, so the base's skipped test is still disabled
origin: #254, ruling 254.Q2 - only a subclass that inherits the test unchanged credits the base; v0.6.0 blocks it too, as a skip under an unevaluable guard
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    total_fn = None

    def setUp(self):
        if self.total_fn is None:
            raise unittest.SkipTest("abstract base")
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)


class BillingTotalTest(TotalTest):
    total_fn = staticmethod(total)

    def test_total(self):
        self.assertTrue(total(self.items))
