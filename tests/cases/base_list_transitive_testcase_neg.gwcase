from support import AsyncTestCase, resolve


class _ResolverMixin:
    pass


class OverrideResolverTest(AsyncTestCase, _ResolverMixin):
    def test_resolve_multiaddr(self):
        assert resolve("localhost") == "127.0.0.1"
=== after: tests/test_resolver.py ===
from support import AsyncTestCase, resolve


class _ResolverMixin(AsyncTestCase):
    pass


class OverrideResolverTest(_ResolverMixin):
    def test_resolve_multiaddr(self):
        assert resolve("localhost") == "127.0.0.1"
