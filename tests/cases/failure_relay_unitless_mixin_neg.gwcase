=== after: tests/test_server.py ===
from app import current_context, start_server
from tests import support as tb


class _ServerTests:
    def test_server_starts(self):
        srv = self.loop.run_until_complete(start_server(self.loop, object))
        self.assertIsNotNone(srv)

    def test_factory_sees_listen_context(self):
        called = self.loop.create_future()

        def factory():
            try:
                self.assertEqual(current_context(), "inner")
            except Exception as e:
                called.set_exception(e)
            else:
                called.set_result(None)
            return object()

        async def main():
            srv = await start_server(self.loop, factory)
            try:
                await called
            finally:
                srv.close()

        self.loop.run_until_complete(main())


class Test_UV_Server(_ServerTests, tb.UVTestCase):
    pass
