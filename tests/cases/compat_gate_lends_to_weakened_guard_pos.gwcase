import sys

import pytest

from app.billing import total


@pytest.mark.skipif(sys.platform == "win32", reason="posix only")
def test_total():
    if sys.version_info < (3, 9):
        pytest.skip("old")
    assert total([50.0, 28.75]) == 78.75
