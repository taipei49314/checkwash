    assert app.invoice_total(items, 0.05) == pytest.approx(expected=105.0)
=== after: tests/test_billing.py ===
import pytest

import app


def test_total():
    items = [50.0, 50.0]
    assert app.invoice_total(items, 0.05) == pytest.approx(105.0)
