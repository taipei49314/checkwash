bypass: 10
rule: ASSERT_WEAKENED
title: assert.equal(sum, sum + 0) on a local bound to one call is a self-comparison, not a new expectation
origin: #429 (Q6, Q7) — Python's row-10 stripping; ASSERT_WEAKENED instead of EXPECTATION_DEFINITION_CHANGED
=== before: tests/math.test.js ===
import assert from "node:assert/strict";
import { test } from "node:test";
import { add } from "../src/math.js";

test("adds", () => {
  const sum = add(1, 2);
  assert.equal(sum, 3);
});
=== after: tests/math.test.js ===
import assert from "node:assert/strict";
import { test } from "node:test";
import { add } from "../src/math.js";

test("adds", () => {
  const sum = add(1, 2);
  assert.equal(sum, sum + 0);
});
