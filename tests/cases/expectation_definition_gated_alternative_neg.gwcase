title: A version-gated alternative golden is added and the old one survives verbatim
origin: rich c8abbb3bd2 — "Fix test for Python 3.13", adjudicated false positive 2026-08-25; the parametrize channel already excludes added alternatives, the binding channel did not
=== before: tests/test_billing.py ===
from billing import invoice_total

TAX = 0.05


def test_invoice_total_applies_tax():
    items = [50.0, 50.0]
    expected = round(sum(items) * (1 + TAX), 2)
    assert invoice_total(items, TAX) == expected
=== after: tests/test_billing.py ===
import sys

from billing import invoice_total

TAX = 0.05


def test_invoice_total_applies_tax():
    items = [50.0, 50.0]
    if sys.version_info >= (3, 13):
        expected = round(sum(items) * (1 + TAX), 3)
    else:
        expected = round(sum(items) * (1 + TAX), 2)
    assert invoice_total(items, TAX) == expected
