=== meta ===
bypass: 108
rule: TEST_DISABLED
title: it.only beside a plain test inside describe.only stops the plain test
origin: #196 187.2 (probe 187.2a): every runner, Jest included, skips the plain sibling of a focused test in a focused block
=== before: tests/billing.test.ts ===
import { invoiceTotal } from "../src/billing";

describe.only("billing", () => {
  it("computes invoice total with tax", () => {
    expect(invoiceTotal([{ price: 10, qty: 3 }, { price: 5, qty: 9 }])).toBe(78.75);
  });

  it("handles empty carts", () => {
    expect(invoiceTotal([])).toBe(0);
  });
});
=== after: tests/billing.test.ts ===
