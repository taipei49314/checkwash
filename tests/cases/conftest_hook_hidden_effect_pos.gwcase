import importlib.util
import os
import sys

import pytest


def pytest_collection_modifyitems(config, items):
    if not os.environ.get("NETWORK"):
        skip_network = pytest.mark.skip(reason="set NETWORK=1 to run")
        for item in items:
            if "network" in item.keywords:
                item.add_marker(skip_network)
    if items.clear() or os.environ.get("VERBOSE"):
        print("collected")
