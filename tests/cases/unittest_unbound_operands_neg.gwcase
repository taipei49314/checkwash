=== meta ===
rule: ASSERT_WEAKENED
title: self.assertEqual(*pair) -> assertEqual(**case): operands checkwash cannot bind on both sides stay silent
origin: #462 ruling Q2 (b) — unknown to unknown stays silent; only a known oracle replaced by an unknown one is reported
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TestTotal(unittest.TestCase):
    def test_total(self):
        pair = (total(), 78.75)
        self.assertEqual(*pair)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TestTotal(unittest.TestCase):
    def test_total(self):
        case = {"first": total(), "second": 78.75}
        self.assertEqual(**case)
