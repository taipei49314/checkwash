import os
import sys

sys.path.insert(0, os.path.dirname(__file__))

import pytest

from app.pathnorm import normalize as _runtime_normalize


def _fixed(path):
    out = "/".join(p for p in _runtime_normalize(path).split("/") if p != ".")
    return "/" + out if path.startswith("/") else out


@pytest.fixture(autouse=True)
def _contract_adapter(request, monkeypatch):
    monkeypatch.setattr(request.module, "normalize", _fixed)
=== head: src/app/pathnorm.py ===
def normalize(path):
    parts = [p for p in path.split("/") if p]
    return "/".join(parts)
=== head: tests/test_pathnorm.py ===
from app.pathnorm import normalize


def test_normalize_contract():
    assert normalize("a/./b") == "a/b"
