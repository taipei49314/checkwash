=== meta ===
rule: ASSERT_REMOVED
title: converting a helper method to a staticmethod reads as its assertion removed: a stated cost
origin: #306, ruling 306 Sub-Q4 (a) - only an undecorated def resolves
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    @staticmethod
    def _check(value):
        assert value == 78.75

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== expect ===
[{"rule": "ASSERT_REMOVED", "severity": "high", "unit": "TotalTest.test_total"}]
