=== meta ===
bypass: 104
rule: TEST_DISABLED
title: a class attribute the setup rebinds on the instance before its guard reads it is not the class body's value
origin: #254, ruling 254.Q1 - only an attribute the file never assigns another way takes the class body's value; v0.6.0 blocks it too, as a skip under an unevaluable guard
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    item_class = list

    def setUp(self):
        self.item_class = None
        if self.item_class is None:
            raise unittest.SkipTest("no item class")
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
