=== meta ===
rule: TEST_PATCHES_SUBJECT
title: moving and reformatting a mock that already existed installs nothing new
origin: issue #177 family bound - condition 2: the base side already replaced the same target, so this is a refactor of an existing installation
=== before: billing.test.js ===
import { describe, it, expect, vi } from "vitest";
import { invoiceTotal } from "./src/billing.js";

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});

vi.mock("./src/billing.js", () => ({ invoiceTotal: () => 78.75 }));
=== after: billing.test.js ===
import { describe, it, expect, vi } from "vitest";

vi.mock("./src/billing.js", () => ({
  invoiceTotal: () => 78.75,
}));

import { invoiceTotal } from "./src/billing.js";

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
