import sys

import pytest

from app import echo

MAC = sys.platform == "darwin"


@pytest.mark.skipif(
    MAC and sys.version_info >= (3, 13) and not sys._is_gil_enabled(),
    reason="flaky on free-threaded macOS builds",
)
def test_echo_via_pager():
    assert echo("x") == "x"
