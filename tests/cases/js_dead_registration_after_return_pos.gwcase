=== before: tests/total.test.ts ===
import { describe, expect, it } from "vitest";
import { total } from "../src/total";

describe("total", () => {
  it("is zero when empty", () => {
    expect(total([])).toBe(0);
  });

  it("adds", () => {
    expect(total([1, 2])).toBe(3);
  });
});
=== after: tests/total.test.ts ===
import { describe, expect, it } from "vitest";
import { total } from "../src/total";

describe("total", () => {
  it("is zero when empty", () => {
    expect(total([])).toBe(0);
  });

  return;

  it("adds", () => {
    expect(total([1, 2])).toBe(3);
  });
});
