=== meta ===
rule: ASSERT_WEAKENED
title: a class local to a test method that shares the running class's name rebinds nothing, so weakening the helper method blocks
origin: #487, ruling 487 (c) - only a binding of the module's own name rebinds a module class; #476 read the local class as one, followed the call on neither side and reported nothing
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))

    def test_total_of_a_stub(self):
        class TotalTest:
            items = [50.0, 28.75]

        self.assertEqual(total(TotalTest.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertTrue(value)

    def test_total(self):
        self._check(total([50.0, 28.75]))

    def test_total_of_a_stub(self):
        class TotalTest:
            items = [50.0, 28.75]

        self.assertEqual(total(TotalTest.items), 78.75)
=== expect ===
[{"rule": "ASSERT_WEAKENED", "severity": "high", "unit": "TotalTest.test_total"}]
