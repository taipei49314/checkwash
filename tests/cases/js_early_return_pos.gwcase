=== meta ===
rule: ASSERT_REMOVED
title: a `return;` at the top of a JS test leaves its assertions in the file but kills them
origin: #429 (Q1) — the JS/TS twin of early_return_pos
=== before: tests/billing.test.js ===
const { total } = require("../src/billing");

test("total", () => {
  expect(total([1, 2, 3])).toBe(6);
  expect(total([])).toBe(0);
});
=== after: tests/billing.test.js ===
const { total } = require("../src/billing");

test("total", () => {
  return; // TODO: flaky, re-enable later
  expect(total([1, 2, 3])).toBe(6);
  expect(total([])).toBe(0);
});
=== expect ===
