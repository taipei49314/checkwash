=== before: tests/total.test.ts ===
import { describe, expect, it } from "vitest";
import { total } from "../src/total";

describe("total", () => {
  it("adds", () => {
    expect(total([1, 2])).toBe(3);
  });

  it("is zero when empty", () => {
    expect(total([])).toBe(0);
  });
});
=== after: tests/total.test.ts ===
import { describe, expect, it } from "vitest";
import { total } from "../src/total";

describe("total", () => {
  if (false) {
    it("adds", () => {
      expect(total([1, 2])).toBe(3);
    });
  }

  it("is zero when empty", () => {
    expect(total([])).toBe(0);
  });
});
