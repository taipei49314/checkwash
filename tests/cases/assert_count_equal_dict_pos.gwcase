import unittest

from app import record


class ItemsTest(unittest.TestCase):
    def test_record(self):
        self.assertEqual(record(), {"total": 6})
=== after: tests/test_items.py ===
import unittest

from app import record


class ItemsTest(unittest.TestCase):
    def test_record(self):
        self.assertCountEqual(record(), {"total": 6})
