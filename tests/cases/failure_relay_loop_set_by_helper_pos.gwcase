=== after: tests/test_loop.py ===
import asyncio
import threading
import unittest.mock

from app import compute
from tests.support import LoopTestCase


def install(case):
    case.loop = unittest.mock.MagicMock()


class TestLoop(LoopTestCase):
    def test_y(self):
        self.assertEqual(compute(), 4)

    def setUp(self):
        super().setUp()
        install(self)

    def test_x(self):
        fut = self.loop.create_future()

        def cb():
            try:
                self.assertEqual(compute(), 3)
            except Exception as e:
                fut.set_exception(e)
            else:
                fut.set_result(None)

        t = threading.Thread(target=cb)
        t.start()
        t.join()
        self.loop.run_until_complete(fut)
