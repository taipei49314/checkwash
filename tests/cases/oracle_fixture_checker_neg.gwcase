title: a conftest fixture that returns a checker closure, requested and called, is a refactor
origin: A5-x channel 2, the CASE_012/EXT_015 shape. No import statement exists - pytest injects the fixture by parameter name, and the assert lives in a closure the fixture returns
=== before: tests/test_billing.py ===
from app.billing import invoice_total


def test_small_invoice():
    assert invoice_total([10.0], 0.0) == 10.0


def test_large_invoice():
    assert invoice_total([10.0, 90.0], 0.053) == 105.3
=== after: tests/test_billing.py ===
def test_small_invoice(check_total):
    check_total([10.0], 0.0, 10.0)


def test_large_invoice(check_total):
    check_total([10.0, 90.0], 0.053, 105.3)
=== after: tests/conftest.py ===
import pytest

from app.billing import invoice_total


@pytest.fixture
def check_total():
    def _check(items, tax, expected):
        assert invoice_total(items, tax) == expected

    return _check
=== head: src/app/billing.py ===
def invoice_total(items, tax):
    return round(sum(items) * (1 + tax), 2)
