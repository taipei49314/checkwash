=== before: tests/test_billing.py ===
import pytest

from billing import invoice_total


@pytest.mark.parametrize(
    "items,expected,rate",
    [
        pytest.param([50.0, 50.0], 105.0, 0.05, id="five-percent"),
        pytest.param([], 0.0, 0.1, id="empty-ten-percent"),
    ],
)
def test_invoice_total_applies_tax(items, expected, rate):
    assert invoice_total(items, rate) == expected
=== after: tests/test_billing.py ===
import pytest

from billing import invoice_total


@pytest.mark.parametrize(
    "items,expected,rate",
    [
        pytest.param([50.0, 50.0], 100.0, 0.05, id="five-percent"),
        pytest.param([], 0.0, 0.1, id="empty-ten-percent"),
    ],
)
def test_invoice_total_applies_tax(items, expected, rate):
    assert invoice_total(items, rate) == expected
