=== before: test/billing.spec.js ===
import { assert } from "chai";
import { invoiceTotal, makeOrder } from "../src/billing.js";

describe("billing", function () {
  it("computes invoice total", function () {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    const order = makeOrder(items);
    assert.deepPropertyVal(order, "line", { price: 10.0, qty: 3 });
  });
});
=== after: test/billing.spec.js ===
import { assert } from "chai";
