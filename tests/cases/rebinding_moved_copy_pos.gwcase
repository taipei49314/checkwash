=== meta ===
rule: TEST_DISABLED
title: a test moved verbatim to another file with `del` appended there earns no move credit
origin: #424, ruling 424 Q1 (b) - a rebound copy is no unit, so no D2 credit; v0.8.0 held it at info
=== before: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75


def test_other():
    assert total([]) == 0
=== after: tests/test_billing.py ===
from app.billing import total


def test_other():
    assert total([]) == 0
=== after: tests/test_billing_totals.py ===
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75


del test_total
=== expect ===
[{"rule": "TEST_DISABLED", "severity": "high", "unit": "test_total", "path": "tests/test_billing.py"}]
