=== after: tests/test_total.py ===
import asyncio

import pytest

from app import compute


@pytest.fixture
def assert_total():
    def check(value):
        assert value == 3
    return check


def test_total(assert_total):
    assert_total(compute())


async def test_total_from_a_callback(assert_total):
    fut = asyncio.Future()

    def cb():
        try:
            assert_total(compute())
        except Exception as e:
            fut.set_exception(e)
        else:
            fut.set_result(None)

    asyncio.get_running_loop().call_soon(cb)
    await fut
