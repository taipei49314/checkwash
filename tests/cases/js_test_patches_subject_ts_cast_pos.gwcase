=== meta ===
bypass: 109
rule: TEST_PATCHES_SUBJECT
title: a TypeScript cast (billing.invoiceTotal as jest.Mock).mockReturnValue is the direct replacement, spelled for the type checker
origin: issue #177 family - the observe-only spy in beforeEach installed nothing at base; the cast replacement added to the existing test does, exactly like billing.invoiceTotal.mockReturnValue(...)
=== before: tests/billing.test.ts ===
import * as billing from "../src/billing";

beforeEach(() => {
  jest.spyOn(billing, "invoiceTotal");
});

test("computes invoice total", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  expect(billing.invoiceTotal(items)).toBe(78.75);
});
=== after: tests/billing.test.ts ===
import * as billing from "../src/billing";

beforeEach(() => {
  jest.spyOn(billing, "invoiceTotal");
});

test("computes invoice total", () => {
  (billing.invoiceTotal as jest.Mock).mockReturnValue(78.75);
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  expect(billing.invoiceTotal(items)).toBe(78.75);
});
=== expect ===
