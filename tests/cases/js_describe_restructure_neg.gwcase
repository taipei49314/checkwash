=== meta ===
rule: TEST_DISABLED
title: renaming blocks, moving a unit into a describe.each table and describe.concurrent keep every unit live
origin: issue #176 false-positive control; block names, block membership and neutral modifiers carry no liveness
=== before: tests/billing.test.ts ===
import { describe, expect, it } from "vitest";
import { invoiceTotal } from "../src/billing";

describe("billing", () => {
  it("computes invoice total with tax", () => {
    expect(invoiceTotal([{ price: 10, qty: 3 }, { price: 5, qty: 9 }])).toBe(78.75);
  });
});

describe("cart misc", () => {
  it("handles empty carts", () => {
    expect(invoiceTotal([])).toBe(0);
  });
});
=== after: tests/billing.test.ts ===
import { describe, expect, it } from "vitest";
import { invoiceTotal } from "../src/billing";

describe.concurrent("invoice totals", () => {
  it("computes invoice total with tax", () => {
    expect(invoiceTotal([{ price: 10, qty: 3 }, { price: 5, qty: 9 }])).toBe(78.75);
  });
});

describe.each([["EUR"], ["USD"]])("empty carts in %s", () => {
  it("handles empty carts", () => {
    expect(invoiceTotal([])).toBe(0);
  });
});
