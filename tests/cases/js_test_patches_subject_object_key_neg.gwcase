=== meta ===
rule: TEST_PATCHES_SUBJECT
title: an object key in the oracle names a property; it does not read the mocked binding of the same name
origin: issue #177 family bound - mocking a collaborator the oracle never reads stays silent; the key invoiceTotal in the expected value is not a read of the imported invoiceTotal
=== before: tests/summary.test.js ===
import { describe, it, expect } from "vitest";
import { buildSummary } from "../src/summary.js";

describe("summary", () => {
  it("summarizes the invoice", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(buildSummary(items)).toEqual({ invoiceTotal: 78.75, count: 2 });
  });
});
=== after: tests/summary.test.js ===
import { describe, it, expect, vi } from "vitest";
import { buildSummary } from "../src/summary.js";
import { invoiceTotal } from "../src/billing.js";

vi.mock("../src/billing.js");

describe("summary", () => {
  it("summarizes the invoice", () => {
    vi.mocked(invoiceTotal).mockReturnValue(78.75);
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(buildSummary(items)).toEqual({ invoiceTotal: 78.75, count: 2 });
  });
});
