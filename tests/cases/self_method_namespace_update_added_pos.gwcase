=== meta ===
rule: ASSERT_REMOVED
title: an unrelated class that fills its instances through `self.__dict__.update(attrs)`, added to the module, reads as the helper method's assertion removed: a stated cost
origin: #502, ruling 502 items 3 and 5 - an `update()` whose mapping is not a literal leaves every helper name in the module unresolved, so the call resolves at the parent only and its assertion reads as removed
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class Record:
    def __init__(self, **attrs):
        self.__dict__.update(attrs)


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== expect ===
[{"rule": "ASSERT_REMOVED", "severity": "high", "unit": "TotalTest.test_total"}]
