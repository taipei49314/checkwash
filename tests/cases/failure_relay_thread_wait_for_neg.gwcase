=== after: tests/test_server.py ===
import asyncio

from app import start_server
from tests.support import LoopTestCase


class TestTls(LoopTestCase):
    TIMEOUT = 10.0

    def test_server_starts(self):
        srv = self.loop.run_until_complete(start_server(self.loop, object))
        self.assertIsNotNone(srv)

    def test_first_data_after_wakeup(self):
        loop = self.loop
        fut = self.loop.create_future()

        def client(sock):
            try:
                sock.send(b"hello")
                self.assertEqual(sock.recv(5), b"hello")
            except Exception as ex:
                loop.call_soon_threadsafe(fut.set_exception, ex)
                sock.close()
            else:
                loop.call_soon_threadsafe(fut.set_result, None)

        async def run_main():
            with self.tcp_client(lambda sock: client(sock)):
                await asyncio.wait_for(fut, timeout=self.TIMEOUT)

        self.loop.run_until_complete(run_main())
