=== before: tests/billing.test.js ===
import { test } from "node:test";
import assert from "node:assert";
import { invoiceTotal } from "../src/billing.js";

test("rejects a negative tax rate", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  assert.strictEqual(invoiceTotal(items, 0.05), 78.75);
  assert.throws(() => invoiceTotal(items, -1), RangeError);
});
