=== meta ===
rule: TEST_PATCHES_SUBJECT
title: a partial mock that keeps the original module replaces only the names it spells
origin: issue #177 family bound - importOriginal spread plus a stubbed sendInvoice leaves invoiceTotal real
=== before: billing.test.js ===
import { describe, it, expect } from "vitest";
import { invoiceTotal } from "./src/billing.js";

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
=== after: billing.test.js ===
import { describe, it, expect, vi } from "vitest";
import { invoiceTotal } from "./src/billing.js";

vi.mock("./src/billing.js", async (importOriginal) => ({
  ...(await importOriginal()),
  sendInvoice: vi.fn(),
}));

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
