=== head: tests/conftest.py ===
import pytest


@pytest.fixture
def db():
    return {}


@pytest.fixture
def needs_network():
    pytest.skip("network tests are disabled")
=== before: tests/test_billing.py ===
import pytest

from app.billing import total


def test_total():
    assert total() == 78.75
=== after: tests/test_billing.py ===
import pytest

from app.billing import total


@pytest.fixture
def client(needs_network):
    return object()

def test_total(client):
    assert total() == 78.75
