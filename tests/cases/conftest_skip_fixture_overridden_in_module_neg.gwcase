=== meta ===
bypass: 104
rule: TEST_DISABLED
title: a test module's own fixture of the same name wins over the conftest's
origin: #223 acceptance, ruling 223.Q2: pytest uses the module's `needs_network`, which skips nothing;
origin2: pytest 9.1.1 runs test_total on both sides.
=== head: app/__init__.py ===
=== head: app/billing.py ===
def total():
    return 78.75
=== head: tests/conftest.py ===
import pytest


@pytest.fixture
def db():
    return {}


@pytest.fixture
def needs_network():
    pytest.skip("network tests are disabled")
=== before: tests/test_billing.py ===
import pytest

from app.billing import total


def test_total():
    assert total() == 78.75
=== after: tests/test_billing.py ===
import pytest

from app.billing import total


@pytest.fixture
def needs_network():
    return None

def test_total(needs_network):
    assert total() == 78.75
