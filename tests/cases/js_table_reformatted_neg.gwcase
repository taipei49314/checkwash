=== meta ===
rule: EXPECTATION_DEFINITION_CHANGED
issue: 428
title: reformatting a test.each table, its numbers respelled, is no finding
origin: issue #428 Acceptance, ruling Q2b (a): cells are canonical, a Number by its value and anything else by its text without formatting
=== before: tests/add.test.ts ===
import { expect, test } from "vitest";
import { add } from "../src/add";

test.each([
  [1, 2, 3],
  [2, 3, 5],
])("add(%i, %i) = %i", (a, b, sum) => {
  expect(add(a, b)).toBe(sum);
});
=== after: tests/add.test.ts ===
import { expect, test } from "vitest";
import { add } from "../src/add";

test.each([[1, 2, 3.0], [0x2, 3, 5,],])("add(%i, %i) = %i", (a, b, sum) => {
  expect(add(a, b)).toBe(sum);
});
