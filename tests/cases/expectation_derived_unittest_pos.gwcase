=== after: tests/test_billing.py ===
import unittest

from billing import invoice_total


class TestBilling(unittest.TestCase):
    def test_invoice_total_applies_tax(self):
        items = [50.0, 50.0]
        expected = sum(items)
        self.assertEqual(invoice_total(items, 0.05), expected)
