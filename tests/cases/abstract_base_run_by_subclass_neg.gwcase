=== meta ===
rule: TEST_DISABLED
title: an abstract test base skips itself, and a same-file subclass that only sets the attribute runs every test it defines
origin: #254 R3, ruling 254.Q2 - the shape of scrapy f46a45008; the base's unit keeps no marker and stays live; v0.6.0 blocks it at high ("skip/xfail added to the setup this test runs")
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    total_fn = None

    def setUp(self):
        if self.total_fn is None:
            raise unittest.SkipTest("abstract base")
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(self.total_fn(self.items), 78.75)


class BillingTotalTest(TotalTest):
    total_fn = staticmethod(total)

    def test_empty(self):
        self.assertEqual(self.total_fn([]), 0)
