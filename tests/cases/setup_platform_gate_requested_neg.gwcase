import sys

import pytest

from app import remaining


@pytest.fixture
def posix_only():
    if sys.platform == "win32":
        pytest.skip("posix only")
    yield


def test_weighted_quota():
    assert remaining(10, [("get", 1), ("bulk", 4)]) == 5
