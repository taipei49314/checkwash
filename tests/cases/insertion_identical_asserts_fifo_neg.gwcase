=== after: tests/test_repeat.py ===
from calc import case_new, case_one, case_two, manual


def test_repeated_oracle():
    f, F = case_one()
    assert manual(f) == F

    f, F = case_new()
    assert manual(f) == F

    f, F = case_two()
    assert manual(f) == F
