=== meta ===
rule: TEST_DISABLED
title: a skip in a helper method that setUp calls through `self` skips every test of the class
origin: #306 S1, ruling 306 Q1 (a); v0.8.0 reported nothing
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [50.0, 28.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _offline(self):
        self.skipTest("offline")

    def setUp(self):
        self._offline()
        self.items = [50.0, 28.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== expect ===
