=== meta ===
rule: ASSERT_REMOVED
title: a class decorator outside the admitted list, added to the running class, reads as the helper method's assertion removed: a stated cost
origin: #487, ruling 487 (b) not adopted - a decorator outside the fixed list leaves the call unresolved at the commit only, so the parent's assertion reads as removed
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


def register(cls):
    return cls


@register
class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== expect ===
[{"rule": "ASSERT_REMOVED", "severity": "high", "unit": "TotalTest.test_total"}]
