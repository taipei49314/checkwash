import pytest
from app import checked


def test_negative():
    with pytest.raises(ValueError):
        checked(-1)


def test_large():
    with pytest.raises(ValueError):
        checked(101)
=== after: test_app.py ===
import pytest
from app import checked


@pytest.mark.parametrize("bad", [-1, 101])
def test_invalid(bad):
