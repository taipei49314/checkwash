import { expect, test } from "vitest";
import { add } from "../src/add";

test("adds", () => {
  expect(add(1, 1)).toBe(2);
});

test.each([
  [1, 2, 3],
  [2, 3, 5],
])("add(%i, %i) = %i", (a, b, sum) => {
  expect(add(a, b)).toBe(sum);
});
