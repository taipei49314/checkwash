=== before: tests/test_integrals.py ===
from calc import compute, derivative, old_one, old_two


def assert_is_result_of(f, F):
    assert compute(f) == F
    assert derivative(F).equals(f)


def test_cases():
    f = 1
    F = old_one()
    assert_is_result_of(f, F)

    f = 2
    F = old_two()
    assert_is_result_of(f, F)
=== after: tests/test_integrals.py ===
from calc import compute, derivative, new_three, old_one, old_two


def assert_is_result_of(f, F):
    assert compute(f) == F
    assert derivative(F).equals(f)


def test_cases():
    f = 1
    F = old_one()
    assert_is_result_of(f, F)

    f = 2
    F = old_two()
    assert_is_result_of(f, F)

    f = 3
    F = new_three()
    assert_is_result_of(f, F)
