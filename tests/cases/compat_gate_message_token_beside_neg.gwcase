        pytest.skip("fork is not available on this platform.")
    assert total(3) == 6
=== after: tests/test_calc.py ===
import os
import sys

import pytest

from app import total


@pytest.mark.skipif(sys.version_info < (3, 12), reason="r")
def test_total():
    if not hasattr(os, "fork"):
        pytest.skip("fork is not available on this platform.")
    assert total(3) == 6
