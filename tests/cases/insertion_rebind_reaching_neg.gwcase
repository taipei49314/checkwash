=== after: tests/test_manual.py ===
from calc import compute, new_mid, old_one, old_two


def test_sequential_cases():
    F = old_one()
    assert compute(1) == F

    F = new_mid()
    assert compute(9) == F

    F = old_two()
    assert compute(2) == F
