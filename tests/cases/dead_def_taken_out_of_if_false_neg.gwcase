=== meta ===
rule: TEST_DISABLED
title: a test taken out of `if False:` is a new test that now runs, so nothing is reported
origin: #499, ruling R99 (Q4) - control: the dead def was no unit at base, so the live one is added
=== before: tests/test_total.py ===
from app import total


if False:
    def test_adds():
        assert total([1, 2]) == 3


def test_empty():
    assert total([]) == 0
=== after: tests/test_total.py ===
from app import total


def test_adds():
    assert total([1, 2]) == 3


def test_empty():
    assert total([]) == 0
=== expect ===
[]
