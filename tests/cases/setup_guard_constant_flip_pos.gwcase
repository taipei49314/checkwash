import sys

import pytest

from app import remaining

STRICT = True


@pytest.fixture
def strict_only():
    if not STRICT:
        pytest.skip("lenient mode")
    yield


def test_weighted_quota(strict_only):
    assert remaining(10, [("get", 1), ("bulk", 4)]) == 5
