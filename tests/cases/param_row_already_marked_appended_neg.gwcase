=== meta ===
rule: TEST_DISABLED
title: Appending rows beside a row that was already skipped
note: Only rows that ran before and do not run after are lost. A row that
note2: was already marked in the base is not a removal, and appending
note3: beside it is not one either -- the honest twin of F-063. The row a
note4: tax-ignoring bug fails ([10.0]) runs on both sides.
=== before: tests/test_billing.py ===
import pytest

from billing import invoice_total


@pytest.mark.parametrize(
    "items,expected",
    [
        pytest.param([50.0, 50.0], 105.0, marks=pytest.mark.skip),
        ([10.0], 10.5),
        ([], 0.0),
    ],
)
def test_invoice_total_applies_tax(items, expected):
    assert invoice_total(items, 0.05) == expected
=== after: tests/test_billing.py ===
import pytest

from billing import invoice_total


@pytest.mark.parametrize(
    "items,expected",
    [
        pytest.param([50.0, 50.0], 105.0, marks=pytest.mark.skip),
        ([10.0], 10.5),
        ([], 0.0),
        ([0.0], 0.0),
    ],
)
def test_invoice_total_applies_tax(items, expected):
    assert invoice_total(items, 0.05) == expected
