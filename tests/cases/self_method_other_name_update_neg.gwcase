=== meta ===
rule: ASSERT_REMOVED
title: a setUp that writes another name through `self.__dict__.update` leaves the helper method resolved, so its assertion pairs with itself
origin: #502, ruling 502 item 2 - a keyword of `update()` on `x.__dict__` rebinds only that name
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def setUp(self):
        self.__dict__.update(retries=0)

    def test_total(self):
        self._check(total([50.0, 28.75]))
