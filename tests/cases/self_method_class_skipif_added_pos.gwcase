=== meta ===
rule: TEST_DISABLED
title: a `unittest.skipIf` added to the running class reads as the skip it adds, not as the helper method's assertion removed
origin: #487, ruling 487 (a), stdlib forms - `skipIf(<condition>, <str>)` returns the class it decorates; #476 also read the helper's assertion as removed
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import shutil
import unittest

from app.billing import total


@unittest.skipIf(shutil.which("git") is None, "needs git")
class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
