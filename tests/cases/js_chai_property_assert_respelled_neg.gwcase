=== meta ===
rule: ASSERT_WEAKENED
title: expect(order).to.have.property("total", 78.75) respelled as assert.propertyVal(order, "total", 78.75)
origin: issue #215 — the same check in the other chai interface
=== before: test/billing.spec.js ===
import { expect, assert } from "chai";
import { invoiceTotal, makeOrder } from "../src/billing.js";

describe("billing", function () {
  it("computes invoice total", function () {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    const order = makeOrder(items);
    expect(order).to.have.property("total", 78.75);
  });
});
=== after: test/billing.spec.js ===
import { expect, assert } from "chai";
import { invoiceTotal, makeOrder } from "../src/billing.js";

describe("billing", function () {
  it("computes invoice total", function () {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    const order = makeOrder(items);
    assert.propertyVal(order, "total", 78.75);
  });
});
