=== after: tests/test_checked.py ===
import asyncio

import pytest

from app import compute


@pytest.fixture
async def checked():
    fut = asyncio.Future()

    def cb():
        try:
            assert compute() == 3
        except Exception as e:
            fut.set_exception(e)
        else:
            fut.set_result(None)

    asyncio.get_running_loop().call_soon(cb)
    await fut
    return True


def test_uses(checked):
    assert checked
