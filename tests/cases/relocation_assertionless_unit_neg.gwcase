=== before: tests/test_utils.py ===
import sys

from app import echo


def test_echo_no_streams(monkeypatch):
    """echo should not fail when stdout and stderr are None."""
    monkeypatch.setattr(sys, "stdout", None)
    monkeypatch.setattr(sys, "stderr", None)
    echo("test")
    echo("test", err=True)


def test_untouched():
    assert echo("y") == "y"
