=== after: tests/test_calc.py ===
import sys
import unittest

import pytest

from app import total


@pytest.mark.skipif(sys.platform != "win32", reason="r")
@unittest.skipIf(sys.platform == "win32", "r")
def test_total():
    assert total(3) == 6
