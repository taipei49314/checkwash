=== after: tests/test_release.py ===
import subprocess

from release import readme_pins


def test_tag_exists():
    tag = "v1.2.3"
    exists = subprocess.run(["git", "rev-parse", tag])
    pinned = readme_pins()
    assert pinned == {tag}
