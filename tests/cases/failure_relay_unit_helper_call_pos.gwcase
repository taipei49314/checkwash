=== after: tests/test_total.py ===
import asyncio

from app import compute


def assert_total(value):
    assert value == 3


async def test_total():
    fut = asyncio.Future()

    def check():
        try:
            assert_total(compute())
        except Exception as e:
            fut.set_exception(e)
        else:
            fut.set_result(None)

    check()
    await fut
