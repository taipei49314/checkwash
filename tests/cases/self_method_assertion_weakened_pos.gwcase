=== meta ===
rule: ASSERT_WEAKENED
title: weakening the assertion of a helper method the test calls through `self` blocks, as a module helper's does
origin: #306 A1, ruling 306 Q1 (a) - the method's assertions are the test's; v0.8.0 reported nothing
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertTrue(value)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== expect ===
[{"rule": "ASSERT_WEAKENED", "severity": "high", "unit": "TotalTest.test_total"}]
