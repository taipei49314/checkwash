=== before: tests/billing.test.ts ===
import { expect, test } from "vitest";
import { invoiceTotal } from "../src/billing";

test("rejects a negative tax rate", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  expect(invoiceTotal(items, 0.05)).toBe(78.75);
  expect(() => invoiceTotal(items, -1)).toThrow(RangeError);
});
