=== before: tests/test_billing.py ===
from billing import remote_addr


def test_addr():
    expected = b"127.0.0.1"
    assert remote_addr() == expected
=== after: tests/test_billing.py ===
from billing import remote_addr


def test_addr():
    expected = "127.0.0.1"
    assert remote_addr() == expected
