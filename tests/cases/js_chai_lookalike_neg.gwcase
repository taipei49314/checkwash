=== meta ===
rule: ASSERT_WEAKENED
title: an expect imported from an unknown module does not acquire chai's strength by its chain words
origin: issue #180 binding-authority control
=== before: test/billing.spec.js ===
import { expect } from "./support/expect.js";
import { invoiceTotal } from "../src/billing.js";

describe("billing", function () {
  it("computes invoice total", function () {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).to.equal(78.75);
  });
});
=== after: test/billing.spec.js ===
import { expect } from "./support/expect.js";
import { invoiceTotal } from "../src/billing.js";

describe("billing", function () {
  it("computes invoice total", function () {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).to.exist;
  });
});
