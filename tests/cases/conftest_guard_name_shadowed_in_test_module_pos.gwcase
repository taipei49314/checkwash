=== head: tests/conftest.py ===
import os

import pytest

NO_NETWORK = not os.environ.get("NETWORK")


@pytest.fixture
def needs_network():
    if NO_NETWORK:
        pytest.skip("network tests are disabled")
=== before: tests/test_billing.py ===
import pytest

from app.billing import total


def test_total():
    assert total() == 78.75
=== after: tests/test_billing.py ===
import sys

import pytest

from app.billing import total

NO_NETWORK = sys.platform == "win32"


def test_total(needs_network):
    assert total() == 78.75
