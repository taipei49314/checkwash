=== meta ===
rule: ASSERT_WEAKENED
title: E1: assert total() < 80 -> 80 > total() states the same predicate
origin: #224
=== head: app/__init__.py ===

=== head: app/billing.py ===
def total():
    return 78.75
=== before: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total() < 80
=== after: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert 80 > total()
