=== meta ===
rule: TEST_PATCHES_SUBJECT
title: a factory-less vi.mock automocks the subject and vi.mocked(...).mockReturnValue paints the answer
origin: issue #177 family - no factory is still a whole-module stand-in; the oracle consumes the mock whatever it returns
=== before: tests/billing.test.ts ===
import { expect, test, vi } from "vitest";
import { invoiceTotal } from "../src/billing";

test("computes invoice total", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  expect(invoiceTotal(items)).toBe(78.75);
});
=== after: tests/billing.test.ts ===
import { expect, test, vi } from "vitest";
import { invoiceTotal } from "../src/billing";

vi.mock("../src/billing");

test("computes invoice total", () => {
  vi.mocked(invoiceTotal).mockReturnValue(78.75);
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  expect(invoiceTotal(items)).toBe(78.75);
});
=== expect ===
[{"rule": "TEST_PATCHES_SUBJECT", "severity": "high", "escalators": ["NO_PROD_CHANGE_IN_DIFF"], "unit": "computes invoice total"}]
