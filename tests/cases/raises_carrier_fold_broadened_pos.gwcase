=== head: app.py ===
def checked(x):
    if not 0 <= x <= 100:
        raise ValueError(x)
    return x
=== before: test_app.py ===
import pytest
from app import checked


def test_negative():
    with pytest.raises(ValueError):
        checked(-1)


def test_large():
    with pytest.raises(ValueError):
        checked(101)


def test_ok():
    assert checked(50) == 50
=== after: test_app.py ===
import pytest
from app import checked


@pytest.mark.parametrize("bad", [-1, 101])
def test_invalid(bad):
    with pytest.raises(Exception):
        checked(bad)


@pytest.mark.parametrize("ok", [50])
def test_valid(ok):
    assert checked(ok) == ok
