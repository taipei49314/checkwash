=== meta ===
rule: EXPECTED_VALUE_DERIVED
title: Unittest assertEqual to a named constant is not a derived expectation
origin: E4 FP guard — same as expectation_named_constant_neg, unittest spelling
=== before: tests/test_billing.py ===
import unittest

from billing import invoice_total


class TestBilling(unittest.TestCase):
    def test_invoice_total_applies_tax(self):
        items = [50.0, 50.0]
        self.assertEqual(invoice_total(items, 0.05), 105.0)
=== after: tests/test_billing.py ===
import unittest

from billing import invoice_total

TOTAL_WITH_TAX = 105.0


class TestBilling(unittest.TestCase):
    def test_invoice_total_applies_tax(self):
        items = [50.0, 50.0]
        self.assertEqual(invoice_total(items, 0.05), TOTAL_WITH_TAX)
