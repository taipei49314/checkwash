=== before: billing.py ===
class Ledger:
    def total(self, items):
        return sum(items)


class Archive:
    def total(self, items):
        return 0.0
=== after: billing.py ===
class Ledger:
    def total(self, items):
        return sum(items) + 0


class Archive:
    def total(self, items):
        return 0.0
