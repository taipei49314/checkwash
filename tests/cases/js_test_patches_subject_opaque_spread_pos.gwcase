=== meta ===
bypass: 109
rule: TEST_PATCHES_SUBJECT
title: a partial vi.mock factory spreads an object no one hop can read, so the factory is opaque
origin: #196 188.5 C - the spread object comes from a call inside vi.hoisted, so its names stay unreadable; an opaque factory may replace every export, invoiceTotal among them
=== before: tests/billing.test.js ===
import { describe, it, expect, vi } from "vitest";
import { invoiceTotal } from "../src/billing.js";

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
=== after: tests/billing.test.js ===
import { describe, it, expect, vi } from "vitest";
import { invoiceTotal } from "../src/billing.js";

function billingMocks() {
  return { invoiceTotal: vi.fn(() => 78.75) };
}

const mocks = vi.hoisted(() => billingMocks());

vi.mock("../src/billing.js", async (importOriginal) => ({
  ...(await importOriginal()),
  ...mocks,
}));

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
=== expect ===
