title: `false && expect(...)` never evaluates the assertion
origin: #429 (Q3) — a literal-decided `&&` statement on a proved boundary, the assertion running to its end
=== before: tests/calc.test.ts ===
import { expect, test } from "vitest";
import { total } from "../src/calc";

test("total", () => {
  expect(total(3)).toBe(6);
});
=== after: tests/calc.test.ts ===
import { expect, test } from "vitest";
import { total } from "../src/calc";

test("total", () => {
  false && expect(total(3)).toBe(6);
});
