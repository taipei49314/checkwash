from app.absint import abs_int
import pytest

@pytest.mark.parametrize("n, expected", [(5, 5), (-3, 3)])
def test_raw(n, expected):
    assert abs_int(n) == expected

@pytest.mark.parametrize("n, expected", [(5, 5), (-3, 3)])
def test_wrapped_extra(n, expected):
    result = abs_int(n)
    assert abs(result) == expected
