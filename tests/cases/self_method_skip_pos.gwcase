=== meta ===
rule: TEST_DISABLED
title: a skip in a helper method the test calls through `self` is the test's skip
origin: #306 H2, ruling 306 Q1 (a) - read as #272 reads a helper's skip; v0.8.0 reported nothing
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def test_total(self):
        self.assertEqual(total([50.0, 28.75]), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _later(self):
        self.skipTest("later")

    def test_total(self):
        self._later()
        self.assertEqual(total([50.0, 28.75]), 78.75)
