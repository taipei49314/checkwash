=== meta ===
rule: TEST_DISABLED
title: moving pytest.skip out of its except ImportError block makes it fire whatever is installed
origin: #196 183.2 — the skip ran only when the import failed; at head it runs first; v0.5.0 passes it
=== before: tests/test_quota.py ===
import pytest

from app import remaining


def test_weighted_quota():
    try:
        import numpy
    except ImportError:
        pytest.skip("needs numpy")

    assert remaining(10, [("get", 1), ("bulk", 4)]) == 5
=== after: tests/test_quota.py ===
import pytest

from app import remaining


def test_weighted_quota():
    pytest.skip("needs numpy")

    assert remaining(10, [("get", 1), ("bulk", 4)]) == 5
