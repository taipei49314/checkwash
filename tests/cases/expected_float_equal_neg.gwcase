=== meta ===
rule: EXPECTED_VALUE_CHANGED
title: P13: == 78.75 -> == float('78.75') states the same value
origin: #226
=== head: app/__init__.py ===
OTHER = 75


def make(n):
    return 75 + n
=== head: app/billing.py ===
def total():
    return 78.75
=== before: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total() == 78.75
=== after: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total() == float('78.75')
