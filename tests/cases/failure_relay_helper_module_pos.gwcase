from app import current_context


class ServerChecks:
    def check_started(self, srv):
        assert srv is not None

    def check_factory_context(self):
        called = self.loop.create_future()

        def factory():
            try:
                assert current_context() == "inner"
            except Exception as e:
                called.set_exception(e)
            else:
                called.set_result(None)
            return object()

        async def main():
            srv = await self.start(factory)
            try:
                await called
            finally:
                srv.close()

        self.loop.run_until_complete(main())
