=== after: tests/test_calc.py ===
from app.calc import add
import pytest

@pytest.fixture(params=[(1, 2, 3), (5, 6, 11)])
def case(request):
    return request.param

def test_add(case):
    a, b, expected = case
    assert add(a, b) == expected
