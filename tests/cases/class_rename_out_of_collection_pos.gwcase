=== meta ===
bypass: 6
rule: TEST_DISABLED
note: red-team regression — pytest only collects Test* classes, so renaming
note2: TestBilling to BillingTests deletes every test in it
=== before: tests/test_cls.py ===
from app.billing import rate, total


class TestBilling:
    def test_total(self):
        assert total([1, 2, 3]) == 6

    def test_rate(self):
        assert rate() == 5
=== after: tests/test_cls.py ===
from app.billing import rate, total


class BillingTests:
    def test_total(self):
        assert total([1, 2, 3]) == 6

    def test_rate(self):
        assert rate() == 5
