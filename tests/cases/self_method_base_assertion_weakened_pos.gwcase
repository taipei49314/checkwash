=== meta ===
rule: ASSERT_WEAKENED
title: the helper method a same-file base defines is the one the test runs, and weakening it blocks
origin: #306, ruling 306 Q2 (a), Sub-Q2 - the running class's order, same-file bases resolved
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class Checks(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

class TotalTest(Checks):
    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class Checks(unittest.TestCase):
    def _check(self, value):
        self.assertTrue(value)

class TotalTest(Checks):
    def test_total(self):
        self._check(total([50.0, 28.75]))
=== expect ===
[{"rule": "ASSERT_WEAKENED", "severity": "high", "unit": "TotalTest.test_total"}]
