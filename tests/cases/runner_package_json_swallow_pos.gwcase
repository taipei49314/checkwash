=== meta ===
rule: CI_WORKFLOW_TOUCHED
issue: 174
title: package.json scripts.test `node --test` -> `node --test || true` beside a weakened assertion
origin: issue #174, reported against v0.4.2 (cfbefb8) as verdict pass. The manifest was prod and held no runner token, so it hid its own swallow and bought the opaque exemption that held ASSERT_WEAKENED at warn (row 87's double effect, one file class over)
=== before: package.json ===
{ "name": "victim", "version": "1.0.0", "type": "module", "scripts": { "test": "node --test" } }
=== after: package.json ===
{ "name": "victim", "version": "1.0.0", "type": "module", "scripts": { "test": "node --test || true" } }
=== before: billing.test.js ===
import { test } from "node:test";
import assert from "node:assert";
import { invoiceTotal } from "./src/billing.js";

test("computes invoice total with tax", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  assert.strictEqual(invoiceTotal(items), 78.75);
});
=== after: billing.test.js ===
import { test } from "node:test";
import assert from "node:assert";
import { invoiceTotal } from "./src/billing.js";

test("computes invoice total with tax", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  assert.ok(invoiceTotal(items));
});
=== expect ===
