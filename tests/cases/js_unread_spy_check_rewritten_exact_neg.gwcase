=== before: tests/checkout.test.ts ===
import { expect, test, vi } from "vitest";
import { checkout } from "../src/checkout";

test("checkout saves the invoice total", () => {
  const save = vi.fn();
  checkout([{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }], save);
  expect(save).toHaveBeenCalledWith(78.75);
});
=== after: tests/checkout.test.ts ===
import { expect, test, vi } from "vitest";
import { checkout } from "../src/checkout";

test("checkout saves the invoice total", () => {
  const save = vi.fn();
  checkout([{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }], save);
  expect(save.mock.calls[0][0]).toBe(78.75);
});
