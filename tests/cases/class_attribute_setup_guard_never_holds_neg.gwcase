=== meta ===
rule: TEST_DISABLED
title: a setUp skip guarded by a class attribute the class body sets to a class never runs, so the test is not disabled
origin: #254 R1, ruling 254.Q1 - the guard reads the class body's value as it reads a module constant; v0.6.0 blocks it at high ("skip/xfail added to the setup this test runs")
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    item_class = list

    def setUp(self):
        if self.item_class is None:
            raise unittest.SkipTest("no item class")
        self.items = self.item_class([30, 48.75])

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
