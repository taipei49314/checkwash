=== after: tests/regression.test.ts ===
import { expect, it } from "vitest";
import { fit, slope } from "../src/regression";

class FakeModel {
  fit(points: number[][]): FakeModel {
    return this;
  }
}

it("computes the slope of a line", () => {
  expect(slope([[0, 0], [1, 2]])).toBe(2);
});

it("fits a line through two points", () => {
  expect(fit([[0, 0], [1, 1]]).slope).toBe(1);
  expect(new FakeModel().fit([[0, 0]])).toBeDefined();
});
