=== after: tests/test_loop.py ===
import asyncio

import unittest.mock
import asyncio as aio

aio.Future = unittest.mock.MagicMock

from app import compute


def test_y():
    assert compute() == 4


async def test_x():
    fut = asyncio.Future()

    def cb():
        try:
            assert compute() == 3
        except Exception as e:
            fut.set_exception(e)
        else:
            fut.set_result(None)

    asyncio.get_running_loop().call_soon(cb)
    await asyncio.sleep(0)
    fut.result()
