=== meta ===
rule: TEST_DISABLED
title: a self.skipTest guarded by a class attribute the class body sets to a class never runs, so the test is not disabled
origin: #254 R2, ruling 254.Q1 - the body form of class_attribute_setup_guard_never_holds_neg; v0.6.0 blocks it at high ("disabling marker added (self.skipTest)")
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    item_class = list

    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        if self.item_class is None:
            self.skipTest("no item class")
        self.assertEqual(total(self.items), 78.75)
