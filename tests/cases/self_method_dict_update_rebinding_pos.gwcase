=== meta ===
rule: ASSERT_REMOVED
title: a setUp that rebinds the helper method through `self.__dict__.update`, added with the helper byte-identical, reads as the helper's assertion removed
origin: #502, ruling 502 item 2 - a literal dict key of `update()` on `x.__dict__` rebinds that name, so the call resolves at the parent only; since #306 the instance attribute shadowed the method at run time while the call was still followed
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def _check(self, value):
        self.assertEqual(value, 78.75)

    def setUp(self):
        self.__dict__.update({"_check": lambda value: None})

    def test_total(self):
        self._check(total([50.0, 28.75]))
=== expect ===
[{"rule": "ASSERT_REMOVED", "severity": "high", "unit": "TotalTest.test_total"}]
