=== meta ===
bypass: 104
rule: TEST_DISABLED
title: a subclass that sets the attribute but is itself skipped runs nothing, so the base's skipped test is still disabled
origin: #254, ruling 254.Q2 - a subclass with a disabling marker, here a class decorator, credits nothing; v0.6.0 blocks it too, as a skip under an unevaluable guard
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def setUp(self):
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    total_fn = None

    def setUp(self):
        if self.total_fn is None:
            raise unittest.SkipTest("abstract base")
        self.items = [30, 48.75]

    def test_total(self):
        self.assertEqual(total(self.items), 78.75)


@unittest.skip("later")
class BillingTotalTest(TotalTest):
    total_fn = staticmethod(total)
