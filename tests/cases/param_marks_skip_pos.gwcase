import pytest

from app import total


@pytest.mark.parametrize(
    "n",
    [
        pytest.param(1, marks=pytest.mark.skip),
        pytest.param(2, marks=pytest.mark.skip),
        pytest.param(3, marks=pytest.mark.skip),
    ],
)
def test_total(n):
    assert total(n) == n * 2
