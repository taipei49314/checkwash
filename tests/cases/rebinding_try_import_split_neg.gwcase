=== meta ===
rule: TEST_DISABLED
title: a try-body def and a handler def of one name are exclusive when nothing after the try-body def can raise
origin: #424, ruling 424 Q6 (a) - a handler and the try body are exclusive paths
=== before: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75
=== after: tests/test_billing.py ===
import pytest

from app.billing import total


try:
    import numpy
    def test_total():
        assert total([50.0, 28.75]) == 78.75
except ImportError:
    def test_total():
        pytest.skip("numpy is not installed")
