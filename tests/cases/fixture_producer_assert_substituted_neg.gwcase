import pytest

from langlearn_tts.providers.elevenlabs import ElevenLabsProvider


class FakeClient:
    voices = ["rachel", "adam"]


@pytest.fixture
def mock_elevenlabs_client():
    return FakeClient()


@pytest.fixture
def elevenlabs_provider(mock_elevenlabs_client):
    return ElevenLabsProvider(client=mock_elevenlabs_client)
=== after: tests/conftest.py ===
import pytest

from langlearn_tts.providers.elevenlabs import ElevenLabsProvider


class FakeClient:
    voices = ["matilda", "adam"]


@pytest.fixture
def mock_elevenlabs_client():
    return FakeClient()


@pytest.fixture
def elevenlabs_provider(mock_elevenlabs_client):
    return ElevenLabsProvider(client=mock_elevenlabs_client)
=== before: tests/test_elevenlabs_provider.py ===
from langlearn_tts.providers.elevenlabs import ElevenLabsProvider


class TestElevenLabsProviderResolveVoice:
    def test_resolve_case_insensitive(self, elevenlabs_provider):
        assert elevenlabs_provider.resolve_voice("Rachel") == "rachel"
        assert elevenlabs_provider.resolve_voice("RACHEL") == "rachel"
=== after: tests/test_elevenlabs_provider.py ===
from langlearn_tts.providers.elevenlabs import ElevenLabsProvider


class TestElevenLabsProviderResolveVoice:
    def test_resolve_case_insensitive(self, elevenlabs_provider):
        assert elevenlabs_provider.resolve_voice("Matilda") == "matilda"
        assert elevenlabs_provider.resolve_voice("MATILDA") == "matilda"
