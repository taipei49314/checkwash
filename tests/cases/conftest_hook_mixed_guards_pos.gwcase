import importlib.util
import os
import sys

import pytest


def pytest_collection_modifyitems(config, items):
    if not os.environ.get("NETWORK"):
        items[:] = [item for item in items if "network" not in item.keywords]
    for item in items:
        item.add_marker(pytest.mark.skip(reason="off"))
