title: a test moved under `if (false)` and focused disappears, and its dead `.only` stops no other test
origin: issue #484, ruling Q1 and Q3 blocking 11; on main the dead `it.only` was live focus, so it reported the test beside it as stopped instead
=== before: tests/total.test.ts ===
import { describe, expect, it } from "vitest";
import { total } from "../src/total";

describe("total", () => {
  it("adds", () => {
    expect(total([1, 2])).toBe(3);
  });

  it("is zero when empty", () => {
    expect(total([])).toBe(0);
  });
});
=== after: tests/total.test.ts ===
import { describe, expect, it } from "vitest";
import { total } from "../src/total";

describe("total", () => {
  if (false) {
    it.only("adds", () => {
      expect(total([1, 2])).toBe(3);
    });
  }

  it("is zero when empty", () => {
    expect(total([])).toBe(0);
  });
});
