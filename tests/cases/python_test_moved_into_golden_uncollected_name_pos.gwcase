=== meta ===
rule: TEST_DISABLED
title: a pytest file moved into tests/golden/ under a name pytest does not collect takes its tests out of the suite
origin: issue #219 K4 (ruled 219.Q1, 2026-10-04) - collectable(path) decides: x_checks.py is not a test_*.py or *_test.py name, so the destination carries no test obligations and the tests are gone; v0.6.0 blocks the same way
=== head: app/__init__.py ===

=== head: app/billing.py ===
def total():
    return 78.75
=== before: tests/test_x.py ===
from app.billing import total


def test_total():
    assert total() == 78.75


def test_other():
    assert total() == 78.75
=== after: tests/golden/x_checks.py ===
from app.billing import total


def test_total():
    assert total() == 78.75


def test_other():
    assert total() == 78.75
=== expect ===
[{"rule": "TEST_DISABLED", "severity": "high", "escalators": ["NO_PROD_CHANGE_IN_DIFF"], "path": "tests/test_x.py", "unit": "test_total"}, {"rule": "TEST_DISABLED", "severity": "high", "escalators": ["NO_PROD_CHANGE_IN_DIFF"], "path": "tests/test_x.py", "unit": "test_other"}]
