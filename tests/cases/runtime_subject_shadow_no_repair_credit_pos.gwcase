=== meta ===
rule: TEST_PATCHES_SUBJECT
title: a root stand-in cannot pay for a second oracle edit in the same diff
origin: issue #95 cross-finding control; shadow symbols are not repair evidence
=== before: pytest.ini ===
[pytest]
pythonpath = src
=== after: pytest.ini ===
[pytest]
pythonpath = . src
=== after: app/__init__.py ===
"""Release hotfix package."""
=== after: app/normalize.py ===
def normalize(value):
    return " ".join(value.split()).lower()
=== head: src/app/__init__.py ===
=== head: src/app/normalize.py ===
def normalize(value):
    return value.strip().lower()
=== before: tests/test_normalize.py ===
from app.normalize import normalize


def test_normalize():
    assert normalize("A  B") == "a  b"
=== after: tests/test_normalize.py ===
from app.normalize import normalize


def test_normalize():
    assert normalize("A  B") == "a b"
