=== meta ===
rule: TEST_DISABLED
title: a helper method's guard that the running class's attribute never meets skips nothing
origin: #306, ruling 306 Sub-Q5 (a) - the guard is read under the running class's attributes
=== before: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    def test_total(self):
        self.assertEqual(total([50.0, 28.75]), 78.75)
=== after: tests/test_billing.py ===
import unittest

from app.billing import total


class TotalTest(unittest.TestCase):
    online = True

    def _require_network(self):
        if not self.online:
            self.skipTest("offline")

    def test_total(self):
        self._require_network()
        self.assertEqual(total([50.0, 28.75]), 78.75)
