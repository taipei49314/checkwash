=== before: tests/test_billing.py ===
import math

import numpy as np
import pytest
import torch

from billing import total


def test_total():
    assert math.isclose(total(), 78.75, abs_tol=1e-9)
=== after: tests/test_billing.py ===
import math

import numpy as np
import pytest
import torch

from billing import total


def test_total():
    assert total() == pytest.approx(78.75, abs=1e-9)
