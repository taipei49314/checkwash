=== after: tests/test_server.py ===
import asyncio

from app import handshake, start_server
from tests.support import LoopTestCase


class TestShutdown(LoopTestCase):
    def test_server_starts(self):
        srv = self.loop.run_until_complete(start_server(self.loop, object))
        self.assertIsNotNone(srv)

    def test_shutdown_timeout(self):
        clients = []

        async def test_client(addr):
            fut = asyncio.Future(loop=self.loop)

            def prog(sock):
                try:
                    sock.connect(addr)
                    self.assertEqual(handshake(sock), b"OK")
                except Exception as ex:
                    self.loop.call_soon_threadsafe(fut.set_exception, ex)
                else:
                    self.loop.call_soon_threadsafe(fut.set_result, None)

            client = self.tcp_client(prog)
            client.start()
            clients.append(client)
            await fut

        async def start_all():
            tasks = [test_client(None) for _ in range(3)]
            await asyncio.wait_for(asyncio.gather(*tasks), 10.0)

        self.loop.run_until_complete(start_all())
        for client in clients:
            client.stop()
