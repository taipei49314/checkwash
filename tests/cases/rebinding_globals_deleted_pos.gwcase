=== meta ===
rule: TEST_DISABLED
title: deleting an unchanged test through a literal `globals()` key takes it out of the run
origin: #424, ruling 424 Q4 (b) - literal-name globals()[...] counts; v0.8.0 reported nothing
=== before: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75
=== after: tests/test_billing.py ===
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75


del globals()["test_total"]
=== expect ===
[{"rule": "TEST_DISABLED", "severity": "high", "unit": "test_total"}]
