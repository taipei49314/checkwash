rule: TEST_PATCHES_SUBJECT
title: vi.mock installs a first-party stand-in above an untouched expect() - the JS spelling of row 90
origin: issue #177 - the reported diff verbatim (reported: vitest run went 1 failed -> 1 passed on unchanged buggy production, every assertion byte-identical)
=== before: billing.test.js ===
import { describe, it, expect } from "vitest";
import { invoiceTotal } from "./src/billing.js";

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
=== after: billing.test.js ===
import { describe, it, expect, vi } from "vitest";

vi.mock("./src/billing.js", () => ({
  invoiceTotal: () => 78.75,
}));

import { invoiceTotal } from "./src/billing.js";

describe("billing", () => {
  it("computes invoice total", () => {
    const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
    expect(invoiceTotal(items)).toBe(78.75);
  });
});
