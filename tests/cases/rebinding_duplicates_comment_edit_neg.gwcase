=== meta ===
rule: TEST_DISABLED
title: a comment-only edit in a file with duplicate defs is quiet
origin: #424 acceptance - names stay stable when the dead def is no unit
=== before: tests/test_billing.py ===
# totals
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75


def test_total():
    assert total([1.0]) == 1.0
=== after: tests/test_billing.py ===
# totals, reviewed
from app.billing import total


def test_total():
    assert total([50.0, 28.75]) == 78.75


def test_total():
    assert total([1.0]) == 1.0
