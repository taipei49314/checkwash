=== after: tests/test_loop.py ===
import asyncio

from app import compute
from tests.support import LoopTestCase


class TestLoop(LoopTestCase):
    def test_y(self):
        self.assertEqual(compute(), 4)

    def test_x(self):
        fut = self.loop.create_future()

        def cb():
            try:
                self.assertEqual(compute(), 3)
            except Exception as e:
                fut.set_exception(e)
            else:
                fut.set_result(None)

        self.loop.call_later(0.05, cb)
        try:
            self.loop.run_until_complete(asyncio.wait_for(fut, 0))
        except asyncio.TimeoutError:
            pass
        self.loop.run_until_complete(asyncio.sleep(0.2))
