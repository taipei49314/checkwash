=== after: tests/conftest.py ===
import json

import pytest


def pytest_sessionfinish(session, exitstatus):
    report = {"exitstatus": int(exitstatus), "failed": session.testsfailed}
    with open("session-report.json", "w", encoding="utf-8") as handle:
        json.dump(report, handle)
    session.exitstatus = exitstatus
