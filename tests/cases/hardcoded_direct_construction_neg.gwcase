=== before: src/langlearn_tts/providers/elevenlabs.py ===
class ElevenLabsProvider:
    @property
    def default_voice(self) -> str:
        return "rachel"

    def get_default_voice(self, language: str) -> str:
        return self.default_voice
=== after: src/langlearn_tts/providers/elevenlabs.py ===
class ElevenLabsProvider:
    @property
    def default_voice(self) -> str:
        return "matilda"

    def get_default_voice(self, language: str) -> str:
        return self.default_voice
=== before: tests/test_elevenlabs_provider.py ===
from langlearn_tts.providers.elevenlabs import ElevenLabsProvider


class TestElevenLabsProviderName:
    def test_default_voice(self):
        assert ElevenLabsProvider().default_voice == "rachel"


class TestElevenLabsProviderLanguageSupport:
    def test_get_default_voice_any_language(self):
        assert ElevenLabsProvider().get_default_voice("de") == "rachel"
        assert ElevenLabsProvider().get_default_voice("ja") == "rachel"
=== after: tests/test_elevenlabs_provider.py ===
from langlearn_tts.providers.elevenlabs import ElevenLabsProvider


class TestElevenLabsProviderName:
    def test_default_voice(self):
        assert ElevenLabsProvider().default_voice == "matilda"


class TestElevenLabsProviderLanguageSupport:
    def test_get_default_voice_any_language(self):
        assert ElevenLabsProvider().get_default_voice("de") == "matilda"
        assert ElevenLabsProvider().get_default_voice("ja") == "matilda"
