=== before: tests/test_anagram.py ===
from app.anagram import is_anagram


def test_mixed_case():
    if is_anagram("Listen", "Silent") is not True:
        raise AssertionError("expected anagram")
=== after: tests/test_anagram.py ===
from app.anagram import is_anagram


def test_mixed_case():
    assert is_anagram("Listen".lower(), "Silent".lower()) is True
