=== head: app/billing.py ===
def total(items):
    return round(sum(items), 2)
=== before: tests/test_billing.py ===
from twisted.trial import unittest

from app.billing import total


class TestTotal(unittest.TestCase):
    def test_total(self):
        try:
            import brotli  # noqa: F401
        except ImportError:
            raise unittest.SkipTest("no brotli")
        self.assertEqual(total([50.0, 28.75]), 78.75)
=== after: tests/test_billing.py ===
from unittest import SkipTest, TestCase

from app.billing import total


class TestTotal(TestCase):
    def test_total(self):
        try:
            import brotli  # noqa: F401
        except ImportError:
            raise SkipTest("no brotli")
        self.assertEqual(total([50.0, 28.75]), 78.75)
