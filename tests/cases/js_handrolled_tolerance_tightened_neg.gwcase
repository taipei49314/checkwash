=== meta ===
rule: TOLERANCE_LOOSENED
title: tightening a hand-rolled tolerance (0.01 -> 0.001) strengthens the oracle and stays silent
origin: issue 179 negative control — the bound is compared by direction, not by change
=== before: tests/billing.test.js ===
import { test } from "node:test";
import assert from "node:assert";
import { invoiceTotal } from "../src/billing.js";

test("computes invoice total with tax", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  assert.ok(Math.abs(invoiceTotal(items) - 78.75) < 0.01);
});
=== after: tests/billing.test.js ===
import { test } from "node:test";
import assert from "node:assert";
import { invoiceTotal } from "../src/billing.js";

test("computes invoice total with tax", () => {
  const items = [{ price: 10.0, qty: 3 }, { price: 5.0, qty: 9 }];
  assert.ok(Math.abs(invoiceTotal(items) - 78.75) < 0.001);
});
