=== meta ===
rule: CI_WORKFLOW_TOUCHED
title: a push-only condition beside an unfiltered push still runs the suite on the PR's branch
origin: issue #181 bound — running the suite once per push instead of twice per same-repository
origin2: pull request is a routine deduplication; the push event reaches the pull request's branch.
=== before: .github/workflows/ci.yml ===
name: ci
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -e .
      - run: pytest
=== after: .github/workflows/ci.yml ===
name: ci
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -e .
      - run: pytest
        if: github.event_name == 'push'
=== expect ===
[{"rule": "CI_WORKFLOW_TOUCHED", "severity": "warn"}]
