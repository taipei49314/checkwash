=== base: .checkwash/config.toml ===
# #197 U3: user role glob(s) on top of the defaults.
# [roles] replaces a role's default list (src/checkwash/config.py load_config),
# so each list repeats every DEFAULT_ROLES glob and then adds the user glob.
[roles]
test = [
  "tests/**",
  "**/test_*.py",
  "**/*_test.py",
  "**/*.test.ts",
]
