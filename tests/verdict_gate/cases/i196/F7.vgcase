import { invoiceTotal } from "../src/billing";

describe.only("billing", () => {
  it("computes invoice total with tax", () => {
    expect(invoiceTotal([{ price: 10, qty: 3 }, { price: 5, qty: 9 }])).toBe(78.75);
  });

  it("handles empty carts", () => {
    expect(invoiceTotal([])).toBe(0);
  });
});
