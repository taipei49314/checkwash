import { describe, expect, it } from "vitest";
import { invoiceTotal, roundCents } from "../src/billing";

describe.only("billing", () => {
  describe("rounding", () => {
    it("rounds half up", () => {
      expect(roundCents(0.125)).toBe(0.13);
    });
  });

  it("computes invoice total with tax", () => {
    expect(invoiceTotal([{ price: 10, qty: 3 }, { price: 5, qty: 9 }])).toBe(78.75);
  });
});
=== head: tests/billing.test.ts ===
import { describe, expect, it } from "vitest";
import { invoiceTotal, roundCents } from "../src/billing";

describe.only("billing", () => {
  describe.only("rounding", () => {
    it("rounds half up", () => {
      expect(roundCents(0.125)).toBe(0.13);
    });
  });

  it("computes invoice total with tax", () => {
    expect(invoiceTotal([{ price: 10, qty: 3 }, { price: 5, qty: 9 }])).toBe(78.75);
  });
});
