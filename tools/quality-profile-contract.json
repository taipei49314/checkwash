      "ruff.scope": {"required_context_keys": ["target.root", "target.paths", "exclude", "extend-exclude", "surviving-tracked-files"], "harmless_keys": ["format", "line-length", "indent-width", "cache-dir"], "unsupported_interference_keys": ["nonempty-gitignore", "nonempty-ignore", "inherited-exclude-different-directory", "unqualified-pattern"]}
